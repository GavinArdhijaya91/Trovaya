{
  "name": "trovaya",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20.9.0" },
  "pnpm": {
    "overrides": {
      "axios": ">=1.18.0",
      "ws": ">=8.21.0"
    }
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "env:check": "node scripts/check-env.mjs",
    "env:check:runtime": "node scripts/check-env.mjs --runtime",
    "migrations:check": "node scripts/check-migration-sync.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "dev:web": "pnpm --filter @trovaya/web dev",
    "dev:poison": "pnpm --filter @trovaya/poison-engine dev",
    "dev:reviewer": "pnpm --filter @trovaya/ai-reviewer dev",
    "dev:indexer": "pnpm --filter @trovaya/event-indexer dev",
    "demo:check": "node scripts/check-demo-readiness.mjs",
    "demo:check:live": "node scripts/check-demo-readiness.mjs --live",
    "demo:evidence": "node scripts/validate-demo-evidence.mjs",
    "protection:evidence": "node scripts/validate-protection-evidence.mjs"
  },
  "devDependencies": { "turbo": "^2.10.12" }
}
