AI_REVIEWER_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=8

# Production cloud mode: OpenRouter is OpenAI-compatible. Keep the key server-side.
# Choose an available :free model in the OpenRouter model catalog.
CLOUD_LLM_URL=https://openrouter.ai/api/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=replace-with-openrouter-free-model
AI_REVIEWER_TIMEOUT_SECONDS=8
