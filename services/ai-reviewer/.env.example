# AI Reviewer Configuration
# Provider choices: gemini (recommended), openai_compatible, ollama, or rules
AI_REVIEWER_PROVIDER=gemini

# Google Gemini Configuration
# Get your API key from https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-8b
AI_REVIEWER_GALLERY_RULES_PATH=./skills

# Optional: Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=8

# Optional: Cloud OpenAI-Compatible (e.g. OpenRouter)
CLOUD_LLM_URL=https://openrouter.ai/api/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
AI_REVIEWER_TIMEOUT_SECONDS=8
