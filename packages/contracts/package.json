{
  "name": "@trovaya/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:base-sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:arbitrum-sepolia": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "verify:bsc-testnet": "hardhat verify --network bscTestnet",
    "check:roles": "hardhat run --no-compile scripts/check-roles.ts",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "lint": "solhint contracts/**/*.sol"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.2.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.1",
    "chai": "4.5.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.17",
    "solhint": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
