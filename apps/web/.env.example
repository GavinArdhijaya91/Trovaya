NEXT_PUBLIC_POISON_ENGINE_URL=http://localhost:8000
# Hugging Face Space URL, for example https://<org>-<space>.hf.space
AI_REVIEWER_URL=https://<org>-<space>.hf.space

# Optional in development. Leave empty for injected wallets such as MetaMask.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_BSC_RPC_URL=https://data-seed-prebsc-2-s1.bnbchain.org:8545
NEXT_PUBLIC_TROVAYA_IP_NFT_ADDRESS=
NEXT_PUBLIC_TROVAYA_VAULT_ADDRESS=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Browser-safe Supabase Auth configuration; still constrained by RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side public gallery configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
PINATA_JWT=

# Server-only secure key delivery. Generate VAULT_MASTER_KEY as 32 random bytes in base64.
SUPABASE_SERVICE_ROLE_KEY=
VAULT_RPC_URL=
VAULT_MASTER_KEY=
